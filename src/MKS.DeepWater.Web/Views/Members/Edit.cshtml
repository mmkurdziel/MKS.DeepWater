@model MemberFormViewModel
@{
    ViewData["Title"] = $"Edycja: {Model.FirstName} {Model.LastName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Lista członków</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edycja</li>
    </ol>
</nav>

<h1 class="h4 mb-4">
    Edycja członka
    <span class="text-muted fs-6">nr @Model.MembershipNumber</span>
</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_MemberForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
